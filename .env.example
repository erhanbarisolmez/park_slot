# Bu dosya şablondur (git'e commitlenir, gerçek sır İÇERMEZ).
# Gerçek değerleri bir ".env" kopyasına yaz (.gitignore'da, commitlenmez).
#
# Kullanım: config/*.yaml ve config/slots/*.json içinde RTSP URL'sini
# rtsp://${CAM_LOCAL_USER}:${CAM_LOCAL_PASS}@IP:554/... şeklinde ${VAR} yer
# tutucusuyla yaz - gerçek değer sadece bağlantı anında buradan okunur
# (bkz. src/park_slot/utils/env.py).

CAM_LOCAL_USER=
CAM_LOCAL_PASS=
