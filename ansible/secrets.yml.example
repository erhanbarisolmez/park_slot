# join-k3s.yml'in vars_files ile okuduğu gizli bilgiler - master'a bağlanıp agent olarak
# katılmak için gereken 2 değer. Gerçek değerlerle bu dosyayı "secrets.yml" (.example'sız)
# olarak kopyalayın - secrets.yml .gitignore'da, repo'ya asla girmez.
k3s_url: "https://<MASTER-IP>:6443"
k3s_token: "<sudo cat /var/lib/rancher/k3s/server/node-token cikisi>"
